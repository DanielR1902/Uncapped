# Copy to .env and fill in real values. Never commit .env.

# SQLAlchemy connection string. Defaults to a local SQLite file (db/uncapped.db) if unset.
# Local:  sqlite:///db/uncapped.db
# Cloud:  postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db/uncapped.db

# Used by the llm/ layer (later phase) — OpenRouter API key and model slug.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
